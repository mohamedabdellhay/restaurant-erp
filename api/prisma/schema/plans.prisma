model Plan {
  id           String         @id @default(uuid())
  name         String         @unique
  price        Float
  currency     String         @default("EGP")
  features     String[]
  limits       Json
  description  String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  subscriptions Subscription[]

  @@map("plans")
}
